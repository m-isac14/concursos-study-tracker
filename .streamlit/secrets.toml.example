# ========================================================
# Segredos do Streamlit (Streamlit Cloud & Local)
# ========================================================
# No Streamlit Cloud: Cole em "App Settings" > "Secrets"
# No PC Local: Renomeie uma cópia para ".streamlit/secrets.toml"

# 1. Banco de Dados Relacional (PostgreSQL - Supabase ou Neon) [RECOMENDADO]
# Substitua pela URL de conexão fornecida pelo Supabase / Neon:
[connections.postgresql]
url = "postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# 2. Configurações Legadas do GitHub (Opcional se usar PostgreSQL)
GITHUB_TOKEN = "ghp_SEU_TOKEN_AQUI"
GITHUB_REPO = "m-isac14/concursos-study-tracker"
GITHUB_BRANCH = "main"
